root-title=Gilti
root-desc=A tiny Git server
virtual-root=/

css=/cgit.css
logo=/cgit.png
favicon=/favicon.ico

cache-root=/var/cache/cgit
cache-size=1000
cache-dynamic-ttl=5
cache-repo-ttl=5
cache-root-ttl=5
cache-scanrc-ttl=1

enable-http-clone=0
enable-index-owner=1
enable-index-links=1
enable-commit-graph=1
enable-log-filecount=1
enable-log-linecount=1
enable-tree-linenumbers=1
snapshots=

remove-suffix=1
readme=:README.md
readme=:README
scan-path=/var/lib/gilti/git/repositories
