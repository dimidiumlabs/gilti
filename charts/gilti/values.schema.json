{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "const": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "cgit": {
      "type": "object",
      "properties": {
        "rootTitle": { "type": "string", "pattern": "^[^\\r\\n]*$" },
        "rootDescription": { "type": "string", "pattern": "^[^\\r\\n]*$" },
        "clonePrefix": { "type": "string", "pattern": "^[^\\r\\n]*$" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "retain": { "type": "boolean" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      }
    },
    "httpService": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sshService": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "parentRefs": { "type": "array", "items": { "type": "object" } }
      }
    },
    "sshRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "enum": ["gateway.networking.k8s.io/v1", "gateway.networking.k8s.io/v1alpha2"] },
        "parentRefs": { "type": "array", "items": { "type": "object" } }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "runSizeLimit": { "type": "string", "minLength": 1 },
        "cacheSizeLimit": { "type": "string", "minLength": 1 },
        "tmpSizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 }
  }
}
