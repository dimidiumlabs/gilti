set -eu

CARGO_TERM_COLOR=always
export CARGO_TERM_COLOR

if ! command -v mise >/dev/null 2>&1; then
    mise_version=2026.7.5
    case $(uname -m) in
        x86_64)
            mise_platform=linux-x64
            mise_sha256=be92da3afb180dc71b3ce6fcaaaf2f393812c9c50e9a64c9cb6706cf28edb486
            ;;
        aarch64)
            mise_platform=linux-arm64
            mise_sha256=9020f7453931a6873d60cf204d5935ebd08633b25f675b0820cd06862b4b6450
            ;;
        *)
            echo "unsupported architecture for mise: $(uname -m)" >&2
            exit 1
            ;;
    esac

    mise_root="/tmp/mise-$mise_version-$mise_platform"
    mise_archive="$mise_root.tar.gz"

    rm -rf "$mise_root"
    mkdir -p "$mise_root"
    curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/jdx/mise/releases/download/v$mise_version/mise-v$mise_version-$mise_platform.tar.gz" \
        -o "$mise_archive"

    printf '%s  %s\n' "$mise_sha256" "$mise_archive" | sha256sum --check
    tar -xzf "$mise_archive" -C "$mise_root" --strip-components=1 mise/bin/mise
    rm -f "$mise_archive"

    PATH="$mise_root/bin:$PATH"
    export PATH
fi

if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    if [ -n "${GITHUB_REF:-}" ]; then
        git fetch --unshallow --tags origin "$GITHUB_REF"
    else
        git fetch --unshallow --tags
    fi
fi

# Legal checks
mise run signoff
mise run licenses

# Link & static checks
mise bootstrap --locked --yes --update
mise exec -- cargo fmt --all --check
mise exec -- shellcheck Mirumfile scripts/*.sh tests/*.sh
mise exec -- cargo clippy --workspace --locked --all-targets --all-features --release -- -D warnings

mise exec -- cargo test --all-features --release --locked
mise exec -- tests/chart.sh

for architecture in amd64 arm64; do
    case $architecture in
        amd64) target=x86_64-unknown-linux-musl ;;
        arm64) target=aarch64-unknown-linux-musl ;;
    esac

    mise exec -- cargo zigbuild \
        --manifest-path Cargo.toml \
        --locked \
        --release \
        --package gilti \
        --target "$target"

    output=".container/binary-$architecture"
    rm -rf "$output"
    install -Dm0755 "target/$target/release/gilti" "$output/gilti"
done

# Container checks
revision=${GITHUB_SHA:-$(git rev-parse HEAD)}
builder=$(docker buildx create --driver docker-container --use)
cleanup_builder() {
    docker buildx rm "$builder" >/dev/null 2>&1 || true
}
trap cleanup_builder 0
docker buildx inspect --bootstrap

mise run container -- \
    --tag gilti:ci \
    --build-arg VERSION=ci \
    --build-arg "REVISION=$revision" \
    --provenance false \
    --sbom false \
    --load
IMAGE=gilti:ci tests/smoke.sh

[ "${GITHUB_EVENT_NAME:-}" = push ] || exit 0

# Publish
: "${GITHUB_ACTOR:?GITHUB_ACTOR is required for publishing}"
mise exec -- gh auth token | docker login ghcr.io --username "$GITHUB_ACTOR" --password-stdin
mise exec -- gh auth token | mise exec -- helm registry login ghcr.io \
    --username "$GITHUB_ACTOR" --password-stdin

case ${GITHUB_REF:-} in
    refs/tags/v*)
        version=${GITHUB_REF#refs/tags/v}
        if ! printf '%s\n' "$version" |
            grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$'; then
            echo "release tag is not a supported SemVer: $version" >&2
            exit 1
        fi
        image_tag=$(printf '%s' "$version" | tr + _)
        ;;
    *)
        version="0.0.0-nightly.$(git log -1 --format=%ct)"
        image_tag=nightly
        ;;
esac

mise run container -- \
    --platform linux/amd64,linux/arm64 \
    --tag "ghcr.io/dimidiumlabs/gilti:$image_tag" \
    --tag "ghcr.io/dimidiumlabs/gilti:sha-$revision" \
    --build-arg "VERSION=$version" \
    --build-arg "REVISION=$revision" \
    --push
mise run chart -- \
    --chart charts/gilti \
    --version "$version" \
    --app-version "$version" \
    --push oci://ghcr.io/dimidiumlabs/charts
